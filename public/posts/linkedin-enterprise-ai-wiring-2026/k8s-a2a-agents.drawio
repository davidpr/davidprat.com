<mxfile host="drawio"><diagram id="k8s" name="Self-hosted AI on Kubernetes with A2A"><mxGraphModel dx="1900" dy="1700" grid="1" gridSize="10" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Self-hosted AI on Kubernetes, with A2A between agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;The same cluster, but every agent is its own service: a concierge agent delegates to specialists over A2A · David Prat Robles · linkedin.com/in/davidpratrobles&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=24;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1900" height="70" as="geometry"/></mxCell><mxCell id="inet" value="&lt;b&gt;Internet&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="200" height="24" as="geometry"/></mxCell><mxCell id="apps" value="&lt;b&gt;Web &amp;amp; mobile apps&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;customers&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="105" width="200" height="60" as="geometry"/></mxCell><mxCell id="dns" value="&lt;b&gt;Public DNS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Azure DNS · Route 53 · Cloud DNS&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="105" width="230" height="60" as="geometry"/></mxCell><mxCell id="partner" value="&lt;b&gt;Partner agents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;A2A · other companies&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="105" width="260" height="60" as="geometry"/></mxCell><mxCell id="frontier" value="&lt;b&gt;Frontier model APIs&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Azure OpenAI · Bedrock · Vertex AI&lt;/font&gt;" style="spacingLeft=86;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1300" y="105" width="330" height="60" as="geometry"/></mxCell><mxCell id="vnet" value="VNet / VPC 10.0.0.0/16 · private, one per region · Azure VNet · AWS VPC · Google VPC" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#fbfbfb;strokeColor=#2d7d46;fontColor=#2d7d46;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="1720" height="1600" as="geometry"/></mxCell><mxCell id="sn_edge" value="edge subnet 10.0.0.0/24 (public)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#ffffff;strokeColor=#2d7d46;fontColor=#2d7d46;dashed=1;" vertex="1" parent="vnet"><mxGeometry x="20" y="35" width="660" height="165" as="geometry"/></mxCell><mxCell id="waf" value="&lt;b&gt;WAF + L7 load balancer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;App Gateway · ALB · Cloud LB + Cloud Armor&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;TLS, DDoS, OWASP rules&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="sn_edge"><mxGeometry x="20" y="35" width="300" height="75" as="geometry"/></mxCell><mxCell id="lb" value="&lt;b&gt;Ingress load balancer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;public IP only here; targets the&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;ingress proxies (Gateway API)&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="sn_edge"><mxGeometry x="350" y="35" width="290" height="75" as="geometry"/></mxCell><mxCell id="sn_egress" value="egress subnet 10.0.1.0/24" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#ffffff;strokeColor=#2d7d46;fontColor=#2d7d46;dashed=1;" vertex="1" parent="vnet"><mxGeometry x="700" y="35" width="400" height="165" as="geometry"/></mxCell><mxCell id="fw" value="&lt;b&gt;Egress firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;FQDN allow-list&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="sn_egress"><mxGeometry x="20" y="35" width="175" height="70" as="geometry"/></mxCell><mxCell id="nat" value="&lt;b&gt;NAT gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;fixed outbound IPs&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="sn_egress"><mxGeometry x="210" y="35" width="175" height="70" as="geometry"/></mxCell><mxCell id="eg_note" value="Everything without a private endpoint leaves here: SaaS APIs, image pulls." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="sn_egress"><mxGeometry x="20" y="112" width="370" height="40" as="geometry"/></mxCell><mxCell id="sn_pe" value="private-endpoint subnet 10.0.2.0/24" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#ffffff;strokeColor=#2d7d46;fontColor=#2d7d46;dashed=1;" vertex="1" parent="vnet"><mxGeometry x="1120" y="35" width="580" height="165" as="geometry"/></mxCell><mxCell id="pe_ai" value="&lt;b&gt;Private endpoint: models&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Private Link · PrivateLink · PSC&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="sn_pe"><mxGeometry x="20" y="35" width="265" height="70" as="geometry"/></mxCell><mxCell id="pe_st" value="&lt;b&gt;Private endpoint: storage&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Blob / S3 / GCS, model weights&lt;/font&gt;" style="spacingLeft=62;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="sn_pe"><mxGeometry x="300" y="35" width="265" height="70" as="geometry"/></mxCell><mxCell id="pe_note" value="Private DNS zones resolve the provider names to these private IPs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="sn_pe"><mxGeometry x="20" y="112" width="545" height="40" as="geometry"/></mxCell><mxCell id="cluster" value="Kubernetes cluster · private API endpoint · Pod CIDR 10.244.0.0/16 (overlay) · Service CIDR 10.96.0.0/16" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#f8f9fb;strokeColor=#326ce5;fontColor=#326ce5;" vertex="1" parent="vnet"><mxGeometry x="80" y="235" width="1360" height="1330" as="geometry"/></mxCell><mxCell id="cpu" value="CPU node pool · node subnet 10.0.16.0/20" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster"><mxGeometry x="20" y="40" width="900" height="1200" as="geometry"/></mxCell><mxCell id="gpu" value="GPU node pool · node subnet 10.0.32.0/20" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="cluster"><mxGeometry x="940" y="40" width="400" height="1200" as="geometry"/></mxCell><mxCell id="cp" value="&lt;b&gt;Control plane, managed by EKS / AKS / GKE&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;API server (private endpoint) · etcd · scheduler&lt;/font&gt;" style="spacingLeft=138;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="cluster"><mxGeometry x="20" y="1255" width="1320" height="55" as="geometry"/></mxCell><mxCell id="ns_gw" value="namespace: gateway" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="20" y="40" width="280" height="300" as="geometry"/></mxCell><mxCell id="ing_ctl" value="&lt;b&gt;Ingress controller&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Envoy / Kong&lt;/font&gt;" style="spacingLeft=58;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_gw"><mxGeometry x="20" y="40" width="240" height="50" as="geometry"/></mxCell><mxCell id="ingress" value="&lt;b&gt;Ingress proxy ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;faces users: TLS, routes to agents&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_gw"><mxGeometry x="20" y="120" width="240" height="60" as="geometry"/></mxCell><mxCell id="ing_note" value="Can be the same Envoy or Kong install as the AI gateway, with different routes and a different role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="ns_gw"><mxGeometry x="20" y="195" width="240" height="90" as="geometry"/></mxCell><mxCell id="ns_ag" value="namespace: agents" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="320" y="40" width="280" height="300" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Concierge agent ×N&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;LangGraph supervisor: the only&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;agent that faces users&lt;/font&gt;" style="spacingLeft=66;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ns_ag"><mxGeometry x="20" y="35" width="240" height="70" as="geometry"/></mxCell><mxCell id="spg" value="specialist agents · one Deployment + Agent Card each" style="swimlane;startSize=20;html=1;rounded=1;arcSize=6;dashed=1;fontSize=10;fontStyle=1;fillColor=#fffbe6;swimlaneFillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="ns_ag"><mxGeometry x="20" y="115" width="240" height="80" as="geometry"/></mxCell><mxCell id="sp1" value="&lt;b&gt;intake ×2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="spg"><mxGeometry x="5" y="27" width="74" height="44" as="geometry"/></mxCell><mxCell id="sp2" value="&lt;b&gt;coverage ×2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="spg"><mxGeometry x="83" y="27" width="74" height="44" as="geometry"/></mxCell><mxCell id="sp3" value="&lt;b&gt;fraud ×2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="spg"><mxGeometry x="161" y="27" width="74" height="44" as="geometry"/></mxCell><mxCell id="kagent" value="&lt;b&gt;kagent controller&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Agent resources, one A2A&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;endpoint per agent, UI&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_ag"><mxGeometry x="20" y="210" width="240" height="70" as="geometry"/></mxCell><mxCell id="ns_data" value="namespace: data" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="620" y="40" width="260" height="300" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL ×3&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;checkpoints, claim drafts&lt;/font&gt;" style="spacingTop=34;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_data"><mxGeometry x="20" y="40" width="105" height="110" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;cache, sessions&lt;/font&gt;" style="spacingTop=34;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_data"><mxGeometry x="140" y="40" width="105" height="110" as="geometry"/></mxCell><mxCell id="data_note" value="Each agent keeps its own state: checkpoints and A2A tasks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="ns_data"><mxGeometry x="20" y="165" width="225" height="70" as="geometry"/></mxCell><mxCell id="ns_aig" value="namespace: ai-gateway" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="20" y="370" width="280" height="330" as="geometry"/></mxCell><mxCell id="aigw" value="&lt;b&gt;AI gateway proxy ×3&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;identity · token limits · routing&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;models · MCP tools · A2A agents&lt;/font&gt;" style="spacingLeft=62;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="ns_aig"><mxGeometry x="20" y="40" width="240" height="90" as="geometry"/></mxCell><mxCell id="optA" value="&lt;b&gt;Option A: in the cluster&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;e.g. agentgateway: one entry point&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;for models, MCP tools and A2A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="ns_aig"><mxGeometry x="20" y="150" width="240" height="75" as="geometry"/></mxCell><mxCell id="aig_note" value="Single entry point to models and tools." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="ns_aig"><mxGeometry x="20" y="240" width="240" height="40" as="geometry"/></mxCell><mxCell id="ns_mcp" value="namespace: mcp" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="320" y="370" width="280" height="330" as="geometry"/></mxCell><mxCell id="mcp1" value="&lt;b&gt;policy-mcp ×2&lt;/b&gt;" style="spacingLeft=30;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_mcp"><mxGeometry x="20" y="40" width="240" height="45" as="geometry"/></mxCell><mxCell id="mcp2" value="&lt;b&gt;claims-mcp ×2&lt;/b&gt;" style="spacingLeft=30;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_mcp"><mxGeometry x="20" y="95" width="240" height="45" as="geometry"/></mxCell><mxCell id="mcp3" value="&lt;b&gt;payments-mcp ×2&lt;/b&gt;" style="spacingLeft=30;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_mcp"><mxGeometry x="20" y="150" width="240" height="45" as="geometry"/></mxCell><mxCell id="kmcp" value="&lt;b&gt;kmcp controller&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;MCPServer resources&lt;/font&gt;" style="spacingLeft=32;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="ns_mcp"><mxGeometry x="20" y="215" width="240" height="55" as="geometry"/></mxCell><mxCell id="ns_srv" value="namespace: serving" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="620" y="370" width="260" height="330" as="geometry"/></mxCell><mxCell id="llmd" value="&lt;b&gt;llm-d scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Endpoint Picker (EPP)&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;prefix / KV-cache hits, queue, load&lt;/font&gt;" style="spacingLeft=38;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="ns_srv"><mxGeometry x="20" y="40" width="220" height="85" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;InferencePool&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Gateway API Inference Ext.&lt;/font&gt;" style="spacingLeft=32;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ns_srv"><mxGeometry x="20" y="140" width="220" height="55" as="geometry"/></mxCell><mxCell id="kserve" value="&lt;b&gt;KServe controller&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;LLMInferenceService: version,&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;GPU spec, canary, scaling&lt;/font&gt;" style="spacingLeft=38;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ns_srv"><mxGeometry x="20" y="210" width="220" height="85" as="geometry"/></mxCell><mxCell id="ns_obs" value="namespace: observability" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="20" y="740" width="420" height="260" as="geometry"/></mxCell><mxCell id="otel" value="&lt;b&gt;OTel Collector&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;DaemonSet, every node&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_obs"><mxGeometry x="20" y="40" width="185" height="55" as="geometry"/></mxCell><mxCell id="prom" value="&lt;b&gt;Prometheus&lt;/b&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_obs"><mxGeometry x="220" y="40" width="185" height="55" as="geometry"/></mxCell><mxCell id="graf" value="&lt;b&gt;Grafana&lt;/b&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_obs"><mxGeometry x="20" y="110" width="185" height="55" as="geometry"/></mxCell><mxCell id="lf" value="&lt;b&gt;Langfuse&lt;/b&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_obs"><mxGeometry x="220" y="110" width="185" height="55" as="geometry"/></mxCell><mxCell id="obs_note" value="Traces, metrics, prompt versions and eval scores for every hop." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="ns_obs"><mxGeometry x="20" y="180" width="385" height="50" as="geometry"/></mxCell><mxCell id="ns_plat" value="namespace: platform" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="460" y="740" width="420" height="260" as="geometry"/></mxCell><mxCell id="keda" value="&lt;b&gt;KEDA&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;autoscaling&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_plat"><mxGeometry x="20" y="40" width="185" height="50" as="geometry"/></mxCell><mxCell id="kueue" value="&lt;b&gt;Kueue&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;GPU quotas&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_plat"><mxGeometry x="220" y="40" width="185" height="50" as="geometry"/></mxCell><mxCell id="certm" value="&lt;b&gt;cert-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;TLS&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_plat"><mxGeometry x="20" y="100" width="185" height="50" as="geometry"/></mxCell><mxCell id="eso" value="&lt;b&gt;External Secrets&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;vault → secrets&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_plat"><mxGeometry x="220" y="100" width="185" height="50" as="geometry"/></mxCell><mxCell id="argo" value="&lt;b&gt;Argo CD&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;GitOps for everything above&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_plat"><mxGeometry x="20" y="160" width="385" height="50" as="geometry"/></mxCell><mxCell id="ns_inf" value="namespace: inference" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="gpu"><mxGeometry x="20" y="40" width="360" height="700" as="geometry"/></mxCell><mxCell id="prefill" value="&lt;b&gt;vLLM prefill ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;reads the prompt&lt;/font&gt;" style="spacingLeft=74;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="ns_inf"><mxGeometry x="20" y="45" width="320" height="70" as="geometry"/></mxCell><mxCell id="decode" value="&lt;b&gt;vLLM decode ×4&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;generates the tokens&lt;/font&gt;" style="spacingLeft=74;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="ns_inf"><mxGeometry x="20" y="205" width="320" height="70" as="geometry"/></mxCell><mxCell id="vllm_note" value="Continuous batching, PagedAttention, prefix caching, parallelism across GPUs; KV cache offload to CPU / SSD." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="ns_inf"><mxGeometry x="20" y="290" width="320" height="60" as="geometry"/></mxCell><mxCell id="pvc" value="&lt;b&gt;Model cache (PVC)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;weights from S3 / Blob&lt;/font&gt;" style="spacingTop=34;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_inf"><mxGeometry x="100" y="380" width="160" height="100" as="geometry"/></mxCell><mxCell id="inf_note" value="Mini model: e.g. a small open-weights model served by KServe with an OpenAI-compatible endpoint." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="ns_inf"><mxGeometry x="20" y="500" width="320" height="60" as="geometry"/></mxCell><mxCell id="ns_gpuop" value="namespace: gpu-operator" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="gpu"><mxGeometry x="20" y="770" width="360" height="230" as="geometry"/></mxCell><mxCell id="gpuop" value="&lt;b&gt;NVIDIA GPU Operator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;DaemonSet: drivers, device plugin,&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;DCGM exporter&lt;/font&gt;" style="spacingLeft=70;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_gpuop"><mxGeometry x="20" y="45" width="320" height="85" as="geometry"/></mxCell><mxCell id="ns_kube" value="namespace: kube-system" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="20" y="1020" width="420" height="165" as="geometry"/></mxCell><mxCell id="coredns" value="&lt;b&gt;CoreDNS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;service discovery&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_kube"><mxGeometry x="20" y="40" width="185" height="50" as="geometry"/></mxCell><mxCell id="cilium" value="&lt;b&gt;Cilium (CNI)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;DaemonSet, eBPF&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_kube"><mxGeometry x="220" y="40" width="185" height="50" as="geometry"/></mxCell><mxCell id="extdns" value="&lt;b&gt;ExternalDNS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;writes the DNS records&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_kube"><mxGeometry x="20" y="100" width="185" height="50" as="geometry"/></mxCell><mxCell id="gwapi" value="&lt;b&gt;Gateway API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Gateway · HTTPRoute&lt;/font&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_kube"><mxGeometry x="220" y="100" width="185" height="50" as="geometry"/></mxCell><mxCell id="ns_mesh" value="namespace: istio-system (optional mesh)" style="swimlane;startSize=24;html=1;rounded=1;arcSize=3;dashed=1;fontStyle=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#7a7a7a;" vertex="1" parent="cpu"><mxGeometry x="460" y="1020" width="420" height="165" as="geometry"/></mxCell><mxCell id="ztunnel" value="&lt;b&gt;ztunnel DaemonSet&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;mTLS between all pods&lt;/font&gt;" style="spacingLeft=32;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_mesh"><mxGeometry x="20" y="40" width="185" height="50" as="geometry"/></mxCell><mxCell id="waypoint" value="&lt;b&gt;waypoint proxies&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;L7 policy per namespace&lt;/font&gt;" style="spacingLeft=32;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ns_mesh"><mxGeometry x="220" y="40" width="185" height="50" as="geometry"/></mxCell><mxCell id="netpol" value="&lt;b&gt;NetworkPolicies: default deny&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;agents → ai-gateway only; ai-gateway → mcp, serving, inference, egress&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ns_mesh"><mxGeometry x="20" y="100" width="385" height="50" as="geometry"/></mxCell><mxCell id="gpu_net" value="&lt;b&gt;GPU node networking&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;no public IPs · taint nvidia.com/gpu&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;only the gateway and llm-d reach vLLM&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;optional RDMA / InfiniBand between&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;GPU nodes for multi-node models&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="gpu"><mxGeometry x="20" y="1020" width="360" height="160" as="geometry"/></mxCell><mxCell id="ilb" value="&lt;b&gt;Internal load balancer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;+ small inference gateway&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;(option B only)&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="vnet"><mxGeometry x="1460" y="515" width="240" height="80" as="geometry"/></mxCell><mxCell id="hgw" value="&lt;b&gt;Hybrid gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;ExpressRoute · Direct Connect&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Cloud Interconnect (or VPN)&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="vnet"><mxGeometry x="1460" y="1035" width="240" height="80" as="geometry"/></mxCell><mxCell id="optB" value="Option B: managed gateway, outside the cluster" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="1780" y="820" width="400" height="380" as="geometry"/></mxCell><mxCell id="apim" value="&lt;b&gt;Azure API Management&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;can be VNet-injected&lt;/font&gt;" style="spacingLeft=36;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="optB"><mxGeometry x="20" y="45" width="360" height="50" as="geometry"/></mxCell><mxCell id="agc" value="&lt;b&gt;AWS AgentCore Gateway or API Gateway&lt;/b&gt;" style="spacingLeft=66;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="optB"><mxGeometry x="20" y="105" width="360" height="50" as="geometry"/></mxCell><mxCell id="apigee" value="&lt;b&gt;Google Cloud Apigee&lt;/b&gt;" style="spacingLeft=34;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="optB"><mxGeometry x="20" y="165" width="360" height="50" as="geometry"/></mxCell><mxCell id="optB_note" value="Agents call it like the in-cluster one (just another URL). Frontier calls go straight to the provider; only self-hosted calls come back into the cluster through the internal load balancer. For A2A, API Management imports each agent from its Agent Card and republishes it with its own security." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="optB"><mxGeometry x="20" y="230" width="360" height="120" as="geometry"/></mxCell><mxCell id="core" value="&lt;b&gt;Core systems (on-premises)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;policy admin · claims · payments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1780" y="1230" width="300" height="60" as="geometry"/></mxCell><mxCell id="ic1" value="" style="