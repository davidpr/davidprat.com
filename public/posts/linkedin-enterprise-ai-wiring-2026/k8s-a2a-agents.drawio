mxGeometry></mxCell><mxCell id="e7" value="8 tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;" edge="1" source="aigw" target="mcp2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="940"/><mxPoint x="420" y="947"/></Array></mxGeometry></mxCell><mxCell id="e7b" value="8 → core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;" edge="1" source="mcp3" target="hgw" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="1002"/><mxPoint x="720" y="1190"/><mxPoint x="1470" y="1190"/><mxPoint x="1470" y="1260"/></Array></mxGeometry></mxCell><mxCell id="e7c" value="8 private circuit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;" edge="1" source="hgw" target="core" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ew" value="weights" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;dashed=1;" edge="1" source="pe_st" target="pvc" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1705" y="360"/><mxPoint x="1705" y="415"/><mxPoint x="1470" y="415"/><mxPoint x="1470" y="930"/></Array></mxGeometry></mxCell><mxCell id="eB1" value="option B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#d79b00;dashed=1;" edge="1" source="lg" target="optB" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="555"/><mxPoint x="710" y="404"/><mxPoint x="1980" y="404"/></Array></mxGeometry></mxCell><mxCell id="eB2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#d79b00;dashed=1;" edge="1" source="optB" target="frontier" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2120" y="135"/></Array></mxGeometry></mxCell><mxCell id="eB3" value="self-hosted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#d79b00;dashed=1;" edge="1" source="ilb" target="decode" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eB4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#d79b00;dashed=1;" edge="1" source="optB" target="ilb" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="860"/></Array></mxGeometry></mxCell><mxCell id="eA7" value="7 A2A task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f6fd1;fontColor=#1f6fd1;exitX=0.83;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="aigw" target="kagent" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="815"/><mxPoint x="712" y="815"/><mxPoint x="712" y="745"/></Array></mxGeometry></mxCell><mxCell id="eA7b" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f6fd1;fontColor=#1f6fd1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="kagent" target="spg" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eA9" value="9 A2A to partners" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f6fd1;fontColor=#1f6fd1;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;" edge="1" source="aigw" target="fw" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="154" y="897"/><mxPoint x="154" y="392"/><mxPoint x="827" y="392"/></Array></mxGeometry></mxCell><mxCell id="eA9b" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f6fd1;fontColor=#1f6fd1;dashed=1;" edge="1" source="fw" target="partner" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Path of a request&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; The app reaches the cluster through the WAF, the load balancer and the ingress proxy.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; The ingress routes the call to the concierge agent.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; The concierge asks the AI gateway for a model; every agent does the same.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; mini is self-hosted: the gateway asks llm-d which pod, then calls that vLLM pod.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; reasoning is a frontier model: the AI gateway calls the external API through the private endpoint.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; The concierge delegates over A2A; the AI gateway checks identity and limits.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; The gateway forwards the task to the specialist&amp;#x27;s A2A endpoint, served by kagent.&lt;br&gt;&lt;b&gt;8&lt;/b&gt; The specialist calls its tools through the AI gateway: MCP pods, then the core systems.&lt;br&gt;&lt;b&gt;9&lt;/b&gt; Agents of other companies are reached the same way: A2A through the gateway, out through the egress firewall.&lt;br&gt;&lt;b&gt;10&lt;/b&gt; Each agent keeps its own state in PostgreSQL; the OTel Collector traces every hop.&lt;br&gt;&lt;br&gt;&lt;b&gt;Networking&lt;/b&gt;&lt;br&gt;Only the WAF and ingress load balancer have public IPs; nodes, pods and the Kubernetes API are private.&lt;br&gt;Models and storage are reached through private endpoints (Private Link / PrivateLink / PSC); everything else leaves through the egress firewall and NAT.&lt;br&gt;Core systems are reached over ExpressRoute / Direct Connect / Cloud Interconnect. Inside the cluster: Cilium, default-deny NetworkPolicies and optional mTLS (Istio ambient).&lt;br&gt;&lt;br&gt;&lt;i&gt;Without kagent the picture is the same: each agent serves its own A2A endpoint. Steps 6-7 are a choice: agents of one team can also call each other directly, pod to pod. Keep the gateway at the border, between teams and with other companies. Blue: A2A.&lt;/i&gt;&lt;br&gt;&lt;i&gt;Dashed orange, a managed gateway outside the cluster. Only self-hosted calls re-enter.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="1800" width="1090" height="370" as="geometry"/></mxCell><mxCell id="clouds" value="&lt;b&gt;Networking services by cloud&lt;/b&gt;&lt;table style=&#x27;border-collapse:collapse;margin-top:6px;width:100%;font-size:12px&#x27;&gt;&lt;tr&gt;&lt;th style=&#x27;padding:3px 8px;color:#ffffff;text-align:left;background:#555555&#x27;&gt;In the diagram&lt;/th&gt;&lt;th style=&#x27;padding:3px 8px;color:#ffffff;text-align:left;background:#0078D4&#x27;&gt;Azure&lt;/th&gt;&lt;th style=&#x27;padding:3px 8px;color:#ffffff;text-align:left;background:#FF9900&#x27;&gt;AWS&lt;/th&gt;&lt;th style=&#x27;padding:3px 8px;color:#ffffff;text-align:left;background:#4285F4&#x27;&gt;Google Cloud&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Virtual network&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Azure VNet&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Amazon VPC&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Google Cloud VPC&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Managed Kubernetes&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;AKS&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;EKS&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;GKE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;WAF + L7 load balancer&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Application Gateway + WAF&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;ALB + AWS WAF&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Cloud Load Balancing + Cloud Armor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Ingress / internal LB&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Azure Load Balancer&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;NLB (Load Balancer Controller)&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Internal Application LB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Egress firewall&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Azure Firewall&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;AWS Network Firewall&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Cloud NGFW&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;NAT gateway&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Azure NAT Gateway&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;NAT Gateway&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Cloud NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Private endpoint: models&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Private Link → Azure OpenAI&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;PrivateLink → Bedrock&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Private Service Connect → Vertex AI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Private endpoint: storage&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Private Endpoint → Blob&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;VPC endpoint → S3&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Private Google Access → GCS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Public DNS&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Azure DNS&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Route 53&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Cloud DNS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Private DNS&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Private DNS zones&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Route 53 private hosted zones&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Cloud DNS private zones&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Hybrid connectivity&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;ExpressRoute / VPN Gateway&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Direct Connect / Site-to-Site VPN&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Cloud Interconnect / Cloud VPN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;font-weight:bold;&#x27;&gt;Managed AI gateway (option B)&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;API Management&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;AgentCore Gateway / API Gateway&lt;/td&gt;&lt;td style=&#x27;padding:2px 8px;border-top:1px solid #dddddd;text-align:left;&#x27;&gt;Apigee&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;arcSize=4;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1130" y="1800" width="1050" height="370" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>